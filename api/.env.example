# ─── Application ─────────────────────────────────────────────────────────────

APP_NAME="Game Voting API"

# "local" | "production"
APP_ENV=local

#   php artisan key:generate --show
APP_KEY=

APP_DEBUG=true

# Public-facing URL of the API.
APP_URL=http://localhost:8000

# The public URL of your frontend (CORS).
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# External API URLs.
ESSENSE_API_URL=https://codechallenge.essensedesigns.info
STEAM_API_URL=https://store.steampowered.com/api

# API key for the Essense challenge portal.
ESSENSE_API_KEY=


# Storage / Cache.
CACHE_STORE=file
SESSION_DRIVER=file

# Logging.
LOG_CHANNEL=stderr

# Bypasses the one-action-per-day limit. Set to false in production.
ALLOW_UNLIMITED_ACTIONS=false

# Trusted proxies.
TRUSTED_PROXIES=
